{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "schedule": ["* 0-6 * * *"],
  "timezone": "America/Denver",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates for all packages (actions are already digest-pinned via config:best-practices)",
      "matchDatasources": [
        "npm",
        "node-version",
        "go",
        "golang-version",
        "github-tags",
        "pypi",
        "python-version"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "minimumReleaseAge": "14 days",
      "postUpdateOptions": ["goModTidy", "npmDedupe", "npmInstallTwice"]
    },
    {
      "description": "Group Go module updates",
      "matchDatasources": ["go"],
      "groupName": "go dependencies",
      "groupSlug": "go-deps"
    },
    {
      "description": "Group npm updates",
      "matchDatasources": ["npm"],
      "groupName": "npm dependencies",
      "groupSlug": "npm-deps"
    },
    {
      "description": "Group python updates",
      "matchDatasources": ["pypi"],
      "groupName": "python dependencies",
      "groupSlug": "python-deps"
    },
    {
      "description": "Group GitHub Actions",
      "matchDatasources": ["github-tags"],
      "groupName": "github-actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Ignore own action (self) updates",
      "matchDatasources": ["github-tags", "github-digest"],
      "matchPackageNames": ["McTalian-WoW-Addons/wow-build-tools"],
      "enabled": false
    },
    {
      "description": "defusedxml is feature-complete, not actively releasing; don't flag as abandoned",
      "matchPackageNames": ["defusedxml"],
      "abandonmentThreshold": null
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash"
  },
  "prConcurrentLimit": 3
}
